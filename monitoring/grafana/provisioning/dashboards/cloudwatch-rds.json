{
  "uid": "cloudwatch-rds",
  "title": "CloudWatch - RDS",
  "description": "RDS PostgreSQL instance metrics from CloudWatch (AWS/RDS) - CPU, memory, storage, IOPS, latency, connections. Complements the app-level DB health gauge (django-prometheus) with instance-level resource visibility CloudWatch alone provides.",
