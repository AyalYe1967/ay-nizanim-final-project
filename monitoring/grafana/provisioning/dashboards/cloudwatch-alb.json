{
  "uid": "cloudwatch-alb",
  "title": "CloudWatch - ALB",
  "description": "Application Load Balancer metrics from CloudWatch (AWS/ApplicationELB) - requests, latency, host health, and connections. Complements the ALB /ping/ health check with request-level and error visibility Prometheus does not have.",
  "tags": [
    "cloudwatch",
    "alb",
    "aws"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total Requests (sum)",
